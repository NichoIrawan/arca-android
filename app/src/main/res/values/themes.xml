<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All Compose styling comes from ArcaTheme (designsystem/).
         The window background is the Arca surface, so launch shows the right page colour in
         both themes instead of a white flash before Compose draws. -->
    <style name="Theme.Arca" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/arca_surface</item>
        <item name="colorPrimary">@color/arca_ink</item>
        <item name="android:textColorPrimary">@color/arca_ink</item>
    </style>

    <!-- CaptureActivity: translucent host for the capture sheet (DD-A12). -->
    <style name="Theme.Arca.Capture">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
