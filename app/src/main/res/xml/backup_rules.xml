<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 10–11 (API 29–30). API 31+ reads data_extraction_rules.xml instead;
     keep the two in step. SDD-ARC-002 DD-A16.

     Exclude-only on purpose: an <include> would switch to "only what's listed", and the Room
     database must go with its -wal/-shm files, which are named after it. The capture context
     (last account and date) is excluded: restored onto another phone it's noise. -->
<full-backup-content>
    <exclude domain="file" path="datastore/capture_context.preferences_pb" />
</full-backup-content>
