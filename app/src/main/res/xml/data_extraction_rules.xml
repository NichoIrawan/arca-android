<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer on Android 12+ (API 31+). Mirrors
     backup_rules.xml; see the reasoning there. SDD-ARC-002 DD-A16. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/capture_context.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/capture_context.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
